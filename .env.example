# ═══════════════════════════════════════════════
# CollegeYatra — Environment Configuration EXAMPLE
# Copy this to .env and run: node setup.js
# ═══════════════════════════════════════════════

PORT=3000

# Admin credentials (bcrypt hashes — generated by setup.js)
ADMIN_USERNAME_HASH=
ADMIN_PASSWORD_HASH=

# Random session secret (generated by setup.js)
SESSION_SECRET=
